{
  "name": "dsh-suggest-prompt",
  "private": true,
  "version": "0.1.0",
  "description": "Suggested next prompt for the DeepSeek Harness: host generation plugin plus the web composer ghost-text surface",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-compact": "file:./stubs/dsh-compact",
      "@deepseek-ai/dsh-type-meta": "file:./stubs/dsh-type-meta",
      "@deepseek-ai/dsh-environment": "file:./stubs/dsh-environment"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
